# Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom model (defaults to claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Supabase Configuration (Optional - for Memory & Context System and Database Integration)
# Get your keys from: https://app.supabase.com/project/_/settings/api
# Without Supabase, preferences are stored in localStorage (single-user mode)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Sheets API Key (Optional - for private spreadsheets)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Airtable API Key (Optional - for Airtable integration)
# Get your API key from: https://airtable.com/account
# AIRTABLE_API_KEY=your_airtable_api_key_here
